# Copy this file to .env and fill in the API keys for the providers you use
# (see libs/llm/llm_providers.yaml for the provider -> key mapping).

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHERAI_API_KEY=
# any non-empty value works for the self-hosted vLLM endpoint
CUSTOM_API_KEY=

# Optional: override the SWE-bench checkout pinned by the flake.
# Inside `nix develop` the pinned checkout takes precedence over this value.
# SWE_BENCH_PATH=
